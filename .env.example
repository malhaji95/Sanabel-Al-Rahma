APP_NAME="سنابل الوفاء"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Damascus
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL (CLAUDE.md §1). The suite runs against whatever engine is set
# here; phpunit.xml pins only the database name, so a test run can never
# reach the working database. For a managed database across the internet,
# add DB_SSLMODE=require — the default, 'prefer', silently falls back to
# plaintext.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sanabel
DB_USERNAME=sanabel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Media storage. 'media_local' keeps files on the application server under
# storage/app/private/media, served only through signed expiring URLs.
# Switch to 'media' once an S3-compatible private bucket exists.
SANABEL_MEDIA_DISK=media_local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sanabel-private
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# T-68 - Redis. CLAUDE.md 1 names Redis queues as the stack; the deployment
# falls back to PostgreSQL because one free container has no Redis. On a host
# that has it, set the five below and nothing else changes: the cache, the
# session and the queue take one database each, so clearing the cache does not
# sign every user out.
#
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3

# T-179 - the second factor on the panels.
#
# Enforced unless this says otherwise, for admin, council and the two board
# directors. Set it to false to lift the gate for a training afternoon or a
# demonstration; every panel screen then carries a red band saying so, which is
# what keeps "temporary" temporary.
#
# It lives here and not on the settings screen on purpose: an account that got
# into the panel must not be able to turn off the lock on the panel. Putting it
# back needs a hand on the server and a restart.
#
# SANABEL_TWO_FACTOR=false
