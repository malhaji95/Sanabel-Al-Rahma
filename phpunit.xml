<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            The engine, host and port come from .env, so the suite runs against
            whatever you deploy on. Only the database name is pinned, so tests
            can never touch the working database.
        -->
        <env name="DB_DATABASE" value="sanabel_test"/>
        <!--
            T-87 — the donor list is held for a minute in production. In a test
            two requests are a few milliseconds apart, so a cached page would
            answer with what the test had just changed away from. Zero computes
            every time; PublicListCacheTest turns it on to test the cache
            itself.
        -->
        <env name="SANABEL_PUBLIC_LIST_CACHE" value="0"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="SANABEL_MEDIA_DISK" value="media_test"/>
        <!--
            T-179 - the second factor stays enforced for the suite, whatever
            the server's own .env says. A deployment that has lifted the gate
            for an afternoon of training must not quietly lift it for the
            tests that prove the gate is there: T-38's guarantee is only worth
            what the suite checks. The test that exercises the lifted path
            overrides the config itself, which is the only way it is reached.
        -->
        <env name="SANABEL_TWO_FACTOR" value="true"/>
    </php>
</phpunit>
